{
  "name": "njbrand-vault",
  "version": "1.0.0",
  "description": "Zero-knowledge, end-to-end encrypted password manager with shared vaults",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/server.js",
    "backup": "node --disable-warning=ExperimentalWarning server/backup-cli.js",
    "restore": "node --disable-warning=ExperimentalWarning server/backup-cli.js restore",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
